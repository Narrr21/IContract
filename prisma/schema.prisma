generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum UserCategory {
    MANAGEMENT
    ADMIN
    HR
    LEGAL
}

model User {
  id          Int       @id @default(autoincrement())
  email       String    @unique
  firstname   String?
  lastname    String?
  category    UserCategory 
  password    String
  profilepath String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  contracts   Contract[]

  @@map("users")
}

model Contract {
  id                Int       @id @default(autoincrement())
  status            String    @default("draft")
  title             String
  userId            Int
  counterparty      String
  type              String
  startdate         DateTime
  terminationdate   DateTime
  compensationsumm  String
  jurisdiction      String
  content           String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("contracts")
}