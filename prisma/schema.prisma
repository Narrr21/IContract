generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum UserCategory {
    MANAGEMENT
    ADMIN
    HR
    LEGAL
}

enum ContractStatus {
  draft
  aktif
  dihentikan
  berakhir
}

model User {
  id          Int       @id @default(autoincrement())
  email       String    @unique
  firstname   String?
  lastname    String?
  category    UserCategory 
  password    String
  profilepath String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("users")
}

model Contract {
  id                Int       @id @default(autoincrement())
  namakontrak       String
  status            String    @default("draft")
  counterparty      String
  type              String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  jatuhtempo        DateTime

  partnershipDetails Partnership?
  employmentDetails  Employment?

  @@map("contracts")
}

model Partnership {
  id              Int @id @default(autoincrement())
  kontrakid       Int @unique
  nomorkontrak    String
  judul           String
  jenis           String
  tanggalmulai    DateTime
  tanggalakhir    DateTime
  perusahaan1     String
  direktur1       String
  alamat1         String
  nomortel1       String
  email1          String
  npwp1           String
  nomorusaha1     String
  perusahaan2     String
  direktur2       String
  alamat2         String
  nomortel2       String
  email2          String
  npwp2           String
  nomorusaha2     String
  jenislayanan    String
  wilayahoperasi  String
  desklayanan     String
  hak1            String
  hak2            String
  syaratlayanan   String
  nominal         BigInt
  tenggatbayar    DateTime
  syaratbayar     String
  bank            String
  namapemilik     String
  norek           String
  denda           String
  tenggatklaim    DateTime
  makskompensasi  BigInt
  sengketa        String
  majeure         String

  contract        Contract @relation(fields: [kontrakid], references: [id], onDelete: Cascade)

  @@map("partnership_contracts")
}

model Employment {
  id                    Int @id @default(autoincrement())
  kontrakid             Int @unique
  
  // Contract Information
  nomorkontrak          String
  judulkontrak          String
  tanggalmulai          DateTime
  tanggalakhir          DateTime
  
  // Company Information  
  namaperusahaan        String
  namadirektwr          String
  alamatperusahaan      String
  notelpperusahaan      String
  emailperusahaan       String
  npwpperusahaan        String
  
  // Employee Information
  namalengkappegawai    String
  jabatan               String
  alamatpegawai         String
  jeniskelamin          String
  usia                  Int
  jenispegawai          String
  noktp                 String
  notelppegawai         String
  emailpegawai          String
  
  // Job Details
  jobdesc               String
  tempatkerja           String
  waktukerja            String
  waktuistirahat        String
  ketentuancuti         String
  ketentulembur         String
  
  // Compensation
  gajipokok             BigInt
  tunjangantetap        BigInt
  tunjangantidaktetap   BigInt
  jaminansosial         String
  fasilitaslain         String
  
  // Legal & Disciplinary
  perlindunganhukum     String
  kerahasiaan           String
  ketentuandisiplin     String
  sanksi                String
  pelanggaran           String
  pemutusanhubungan     String

  contract              Contract @relation(fields: [kontrakid], references: [id], onDelete: Cascade)

  @@map("employment_contracts")
}